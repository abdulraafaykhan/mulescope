# MuleScope environment variables.
# Copy to .env and fill in real values locally. Never commit .env or real keys.
# PowerShell: Copy-Item .env.example .env

# --- Operational database (API, agents, datagen, evals) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mulescope

# --- Truth database ---
# Used ONLY by datagen (uv run seed) and evals (uv run evals).
# The API process has no setting for these and never reads them.
MONGO_TRUTH_URI=mongodb://localhost:27017
MONGO_TRUTH_DB_NAME=mulescope_truth

# --- LLM providers ---
# Leave empty to run in fallback mode. Not required when LLM_MODE=fallback.
GROQ_API_KEY=
GEMINI_API_KEY=

# live | fallback
LLM_MODE=fallback

# Dataset end date (ISO 8601).
AS_OF_DATE=2026-10-31

# LangGraph checkpoint retention, in days.
CHECKPOINT_TTL_DAYS=7

# Optional: directory of config/*.yaml. Defaults to <project>/config.
# CONFIG_DIR=./config

# --- Mongo client ---
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# --- API server ---
API_HOST=127.0.0.1
API_PORT=8000

# Browser origins allowed by CORS (JSON list). The UI dev server (npm run dev in
# frontend/) runs on http://localhost:5173 and calls the API at VITE_API_URL.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Frontend (read by Vite from frontend/.env.local, shown here for reference) ---
# VITE_API_URL=http://127.0.0.1:8000
